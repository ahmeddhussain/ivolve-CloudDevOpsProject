@Library('jenkins-shared-library') _

pipeline {
    agent any
    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '800770414458'
        ECR_URL        = "${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com"
        IMAGE_NAME     = 'ivolve-auth'
        IMAGE_TAG      = "${BUILD_NUMBER}"
        MANIFEST_PATH  = 'k8s/auth-deploy-svc.yml' // Verify exact filename in k8s/
        GIT_CREDS      = 'github-credentials'
    }
    stages {
        stage('SonarQube Code Quality Scan') {
            steps {
                sonarscan(env.IMAGE_NAME)
            }
        }
        stage('Build Image') {
            steps {
                buildimage(env.IMAGE_NAME, env.IMAGE_TAG, "docker/iVolveFinalProject/auth-service")
            }
        }
        stage('Scan Image') {
            steps {
                scanimage(env.IMAGE_NAME, env.IMAGE_TAG)
            }
        }
        stage('Push Image') {
            steps {
                pushimage(env.AWS_REGION, env.ECR_URL, env.IMAGE_NAME, env.IMAGE_TAG)
            }
        }
        stage('Delete Image Locally') {
            steps {
                deleteimagelocally(env.ECR_URL, env.IMAGE_NAME, env.IMAGE_TAG)
            }
        }
        stage('Update Manifests') {
            steps {
                updatemanifests(env.MANIFEST_PATH, env.IMAGE_NAME, env.IMAGE_TAG, env.ECR_URL)
            }
        }
        stage('Push Manifests') {
            steps {
                pushmanifests(env.GIT_CREDS, "ci(auth): update image tag to ${env.IMAGE_TAG}")
            }
        }
    }
}